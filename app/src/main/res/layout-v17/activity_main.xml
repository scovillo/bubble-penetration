<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black" tools:context="de.spicysources.bubblepenetration.MainActivity">

    <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:id="@+id/menuGLSurfaceViewHolder"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">

        <Button
                android:id="@+id/highscore_button"
                android:text="@string/highscore_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24dp"
                android:onClick="showHighscores"
                android:layout_alignParentTop="true"
                android:layout_gravity="left|top"
                android:enabled="true"
                android:alpha="0.7"/>
    </FrameLayout>

    <Button
            android:id="@+id/start_button"
            android:text="@string/start_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40dp"
            android:onClick="startGame"
            android:enabled="true"
            android:alpha="0.8"
            android:layout_gravity="center"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_marginLeft="389dp"
            android:layout_marginStart="389dp"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/menu_title"
            android:text="Bubble Penetration"
            android:textColor="#ec5108ff"
            android:textSize="48sp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal|top"
            android:textAlignment="center"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="@string/username"
            android:id="@+id/menu_username"
            android:layout_gravity="left|bottom"
            android:textSize="24sp"
            android:textColor="#ffffff"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:onClick="editUsername"/>

    <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music"
            android:id="@+id/music_box"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:layout_above="@+id/menu_username"
            android:layout_alignParentEnd="true"
            android:checked="true"
            android:onClick="setMusic"/>

    <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EFFECTS"
            android:id="@+id/effects_box"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:checked="true"/>

</RelativeLayout>
