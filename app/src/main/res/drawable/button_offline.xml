<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp"/>
    <gradient
        android:angle="45"
        android:centerX="35%"
        android:centerColor="#6E6E6E"
        android:startColor="#8A8A8A"
        android:endColor="#383838"
        android:type="linear"/>
    <padding
        android:left="32sp"
        android:top="16sp"
        android:right="32sp"
        android:bottom="16sp"/>
    <stroke
        android:width="3dp"
        android:color="#B0B0B0"/>
</shape>
