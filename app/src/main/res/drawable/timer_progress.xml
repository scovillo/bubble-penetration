<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#354162" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp" /><gradient android:startColor="#73E6FF" android:endColor="#4E7DFF" android:angle="0" /></shape></clip>
    </item>
</layer-list>
