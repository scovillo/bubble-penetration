<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true">
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center">
            <TextView
                    android:id="@+id/game_over_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_over_text"
                    android:textSize="40sp"
                    android:textColor="@color/gold"
                    android:layout_gravity="center_horizontal"
                    android:textStyle="bold|italic"
                    android:enabled="true"/>
            <TextView
                    android:id="@+id/your_score_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_over_score_label"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:enabled="true"/>
            <TextView
                    android:id="@+id/your_score_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="36sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:enabled="true"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_highscore"
                    android:id="@+id/highscore_label"
                    android:textSize="18sp"
                    android:padding="16sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:enabled="true"/>
        </LinearLayout>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/gameover_buttons"
                android:layout_marginTop="8dp"
                android:layout_gravity="center">
            <Button
                    android:id="@+id/highscore_gameover"
                    android:text="@string/highscore_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_margin="6sp"
                    android:onClick="showHighscores"
                    android:background="@drawable/button"
                    android:enabled="true"
                    android:textColor="@color/gold"
                    android:clickable="true"
                    android:focusable="true"/>
            <Button
                    android:id="@+id/rating_button"
                    android:text="@string/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:layout_margin="6sp"
                    android:onClick="launchMarket"
                    android:background="@drawable/button"
                    android:enabled="true"
                    android:textColor="@color/gold"
                    android:clickable="true"
                    android:focusable="true"/>

            <Button
                    android:id="@+id/project_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="6sp"
                    android:layout_weight="1"
                    android:background="@drawable/button"
                    android:clickable="true"
                    android:enabled="true"
                    android:focusable="true"
                    android:onClick="openProjectWebsite"
                    android:text="@string/project"
                    android:textColor="@color/gold"
                    android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>