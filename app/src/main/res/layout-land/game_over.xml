<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    tools:context="de.spicysources.bubblepenetration.MainActivity"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="32dp"
    android:background="@color/black">

    <TextView
        android:id="@+id/game_over_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_over_text"
        android:textSize="40sp"
        android:textColor="@color/title"
        android:layout_gravity="center_horizontal"
        android:textStyle="bold|italic"
        android:enabled="true"
        android:layout_centerHorizontal="true"
        android:layout_alignParentStart="false" />

    <TextView
        android:id="@+id/your_score_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_over_score_label"
        android:textSize="16dp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:enabled="true"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/game_over_textview"/>
    <TextView
        android:id="@+id/your_score_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="28dp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:enabled="true"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/your_score_label"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Highscore!!"
        android:id="@+id/highscore_label"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:enabled="true"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/your_score_textview"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/highscore_label"
        android:layout_centerHorizontal="true"
        android:id="@+id/gameover_buttons"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/highscore_gameover"
            android:text="@string/highscore_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:onClick="showHighscores"
            android:background="@drawable/button"
            android:enabled="true"
            android:textColor="@color/gold"
            android:clickable="true"
            android:layout_below="@+id/highscore_label"
            android:layout_toStartOf="@+id/your_score_textview"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/bewerten_button"
            android:text="@string/bewerten"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:onClick="launchMarket"
            android:background="@drawable/button"
            android:enabled="true"
            android:textColor="@color/gold"
            android:clickable="true"
            android:layout_below="@+id/highscore_label"
            android:layout_alignStart="@+id/your_score_textview" />
    </LinearLayout>

</RelativeLayout>