<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center">
            <TextView
                    android:id="@+id/game_over_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_over_text"
                    android:textSize="28sp"
                    android:textColor="@color/gold"
                    android:layout_gravity="center_horizontal"
                    android:textStyle="bold|italic"
                    android:enabled="true"/>
            <TextView
                    android:id="@+id/your_score_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_over_score_label"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:enabled="true"/>
            <TextView
                    android:id="@+id/your_score_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/initial_score"
                    android:textSize="28sp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:enabled="true"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_highscore"
                    android:id="@+id/highscore_label"
                    android:textSize="14sp"
                    android:padding="4dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_horizontal"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp"
                    android:enabled="true"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/play_again_button"
                    android:text="@string/play_again_button_text"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:onClick="startGame"
                    android:background="@drawable/button"
                    android:enabled="true"
                    android:textColor="@color/gold"
                    android:clickable="true"
                    android:focusable="true"/>
            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/highscore_gameover"
                    android:text="@string/highscore_button_text"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:onClick="showHighscores"
                    android:background="@drawable/button"
                    android:enabled="true"
                    android:textColor="@color/gold"
                    android:clickable="true"
                    android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/rating_button"
                    android:text="@string/rating"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:onClick="launchMarket"
                    android:background="@drawable/button"
                    android:enabled="true"
                    android:textColor="@color/gold"
                    android:clickable="true"
                    android:focusable="true"/>
            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/project_button"
                    android:text="@string/project"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:layout_margin="2dp"
                    android:minHeight="0dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:onClick="openProjectWebsite"
                    android:background="@drawable/button"
                    android:enabled="true"
                    android:textColor="@color/gold"
                    android:clickable="true"
                    android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
