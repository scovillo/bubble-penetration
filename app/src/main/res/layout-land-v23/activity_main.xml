<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black" tools:context="de.spicysources.bubblepenetration.MainActivity">

    <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:id="@+id/menuGLSurfaceViewHolder"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
    </FrameLayout>

    <Button
            android:id="@+id/start_button"
            android:text="@string/start_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:onClick="startGame"
            android:background="@drawable/button"
            android:layout_alignParentTop="false"
            android:enabled="true"
            android:alpha="0.9"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/gold"
            android:clickable="true"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/menu_title"
            android:layout_margin="8dp"
            android:focusable="true"/>

    <Button
            android:id="@+id/highscore_button"
            android:text="@string/highscore_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:background="@drawable/button"
            android:onClick="showHighscores"
            android:layout_gravity="center_horizontal"
            android:enabled="true"
            android:textColor="@color/gold"
            android:alpha="0.9"
            android:clickable="true"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/start_button"
            android:focusable="true"/>

    <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/menu_title"
            android:text="@string/bubble_penetration"
            android:textColor="#ec5108ff"
            android:textSize="48sp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal|top"
            android:textAlignment="center"
            android:enabled="true"/>


    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="@string/username"
            android:id="@+id/menu_username"
            android:layout_gravity="left|bottom"
            android:textSize="24sp"
            android:textColor="#ffffff"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:onClick="editUsername"
            android:layout_marginBottom="8sp"
            android:clickable="true"
            android:contextClickable="false"
            android:enabled="true"
            android:layout_marginStart="8sp"
            android:focusable="true"/>

    <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music"
            android:id="@+id/music_box"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:layout_above="@+id/menu_username"
            android:layout_alignParentEnd="true"
            android:checked="true"
            android:onClick="setMusic"
            android:clickable="true"
            android:enabled="true"
            android:focusable="true"/>

    <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EFFECTS"
            android:id="@+id/effects_box"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:checked="true"
            android:clickable="true"
            android:enabled="true"
            android:onClick="setEffects"
            android:focusable="true"/>

</RelativeLayout>
